# Copy to .env and fill in real values.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_NAME=FOURLETTERS
DATABASE_SCHEMA=FOURLETTERS
DATABASE_USER=fourletters
DATABASE_PASSWORD=change-me-db-password

# ---------------------------------------------------------------------------
# RabbitMQ (three scoped users; passwords are hashed into the broker at boot)
#   admin              - management UI, full access
#   fourletters-server - declares the exchange + hub queues, publishes messages
#   fourletters-hub    - binds user routing keys + consumes its queue only
# ---------------------------------------------------------------------------
RABBITMQ_ADMIN_PASSWORD=change-me-admin-password
RABBITMQ_SERVER_PASSWORD=change-me-server-password
RABBITMQ_HUB_PASSWORD=change-me-hub-password

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Comma-separated origin patterns allowed by CORS.
ALLOWED_ORIGIN_PATTERNS=https://localhost
GOOGLE_CLIENT_ID=your-google-oauth-client-id
# Shared secret the Hub must present to register with the Server.
HUB_REGISTRATION_SECRET=change-me-hub-registration-secret
# JWT signing key pair (RSA). The default profile requires these.
# JWT_KEYS_DIR is the host folder mounted read-only into the server container;
# the *_PATH vars are the paths as seen inside the container.
JWT_KEYS_DIR=./certs/jwt
JWT_PRIVATE_KEY_PATH=file:/run/secrets/jwt/private_key.pem
JWT_PUBLIC_KEY_PATH=file:/run/secrets/jwt/public_key.pem
# Web Push (VAPID) - leave blank to disable push.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:olshanskyev@gmail.com

# ---------------------------------------------------------------------------
# GUI (served by nginx, values substituted into the built app at container start)
# ---------------------------------------------------------------------------
# Public host name used in the nginx server_name / SPA config.
HOST=localhost
# API endpoints as seen by the browser (same origin, proxied by nginx).
BASE_URL_SERVER=https://localhost/server/api/v1
BASE_URL_HUB=wss://localhost/hub/api/v1
OAUTH_REDIRECT_URL=https://localhost
VK_APP_ID=0
UMAMI_WEBSITE_ID=
# Cert path (with trailing slash) for HTTPS. Leave blank to serve HTTP only.
CERT_PATH=/etc/letsencrypt/live/localhost/
