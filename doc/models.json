{
  "openapi": "3.0.3",
  "info": {
    "title": "Shared Data Models for Fourletters API",
    "version": "1.0.0",
    "description": "Shared data models for the fourletters."
  },
  "paths": {},
  "components": {
    "schemas": {
      "AuthRequest": {
        "type": "object",
        "required": ["token"],
        "properties": {
          "token": {
            "type": "string",
            "description": "The identity token provided by the third-party OAuth provider."
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": ["access_token", "user"],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "The short-lived JWT Access Token."
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": ["id", "username", "roles"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "format": "uri"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of user permissions/roles for RBAC."
          }
        }
      },
      "EncryptedMessage": {
        "type": "object",
        "required": ["messageId", "recipientId", "payload"],
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the message generated by the client"
          },
          "recipientId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the recipient user"
          },
          "senderId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the sender user (populated by the Hub before delivery)"
          },
          "payload": {
            "type": "string",
            "description": "E2E encrypted message payload (Base64)"
          }
        }
      },
      "MessageAcknowledgement": {
        "type": "object",
        "required": ["messageId"],
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the message being acknowledged"
          }
        }
      },
      "SendMessagePayload": {
        "type": "object",
        "required": ["action", "data"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["sendMessage"]
          },
          "data": {
            "$ref": "#/components/schemas/EncryptedMessage"
          }
        }
      },
      "ReceiveMessagePayload": {
        "type": "object",
        "required": ["event", "data"],
        "properties": {
          "event": {
            "type": "string",
            "enum": ["messageReceived"]
          },
          "data": {
            "$ref": "#/components/schemas/EncryptedMessage"
          }
        }
      },
      "AckMessagePayload": {
        "type": "object",
        "required": ["action", "data"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["ackMessage"]
          },
          "data": {
            "$ref": "#/components/schemas/MessageAcknowledgement"
          }
        }      },
      "MessageDispatchedPayload": {
        "type": "object",
        "required": ["event", "data"],
        "properties": {
          "event": {
            "type": "string",
            "example": "messageDispatched"
          },
          "data": {
            "$ref": "#/components/schemas/MessageAcknowledgement"
          }
        }
      },
      "MessageReadPayload": {
        "type": "object",
        "required": ["event", "data"],
        "properties": {
          "event": {
            "type": "string",
            "example": "messageRead"
          },
          "data": {
            "$ref": "#/components/schemas/MessageAcknowledgement"
          }
        }      }
    }
  }
}