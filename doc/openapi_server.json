{
  "openapi": "3.0.3",
  "info": {
    "title": "Fourletters API - Authentication",
    "version": "1.0.0",
    "description": "Authentication endpoints for the fourletters server"
  },
  "servers": [
    {
      "url": "http://localhost:8080/server/api/v1",
      "description": "Local Hub Development Server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentication and Identity Management"
    },
    {
      "name": "Messages",
      "description": "Sending messages, inbox sync, and signed delivery receipts"
    },
    {
      "name": "Hubs",
      "description": "Hub registration and relay-queue provisioning"
    },
    {
      "name": "Keys",
      "description": "User public-key directory: upload and fetch E2E keys"
    },
    {
      "name": "Groups",
      "description": "Group conversations: roster + epoch management and wrapped group-key distribution"
    }
  ],
  "paths": {
    "/auth/vk": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login using VK OAuth token",
        "description": "Validates the VK OAuth token and issues a new session. Single-active-device policy: a successful login revokes the user's other refresh tokens, so any previously signed-in device becomes revoked on its next refresh.",
        "operationId": "loginVk",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./models.json#/components/schemas/AuthRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully authenticated",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly cookie containing the 'refresh_token'.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./models.json#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token, User not found"
          }
        }
      }
    },
    "/auth/google": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login using Google OAuth token",
        "description": "Validates the Google OAuth token and issues a new session. Single-active-device policy: a successful login revokes the user's other refresh tokens, so any previously signed-in device becomes revoked on its next refresh.",
        "operationId": "loginGoogle",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./models.json#/components/schemas/AuthRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully authenticated",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly cookie containing the 'refresh_token'.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./models.json#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token, User not found"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh Access Token",
        "description": "Consumes the HttpOnly Refresh Token cookie to issue a new Access Token without requiring re-authentication.",
        "operationId": "refreshToken",
        "security": [
          {
            "CookieRefreshAuth": []
          }
        ],
        "parameters": [
          {
            "name": "X-Session-ID",
            "in": "header",
            "required": true,
            "description": "The current session ID. **Note:** This value must match the `jti` (JWT ID) claim of your current access token.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "New access token granted",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly cookie containing the 'refresh_token'.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./models.json#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token is invalid, expired, missing, or was revoked by a newer login. A 'revoked' reason signals the single-active-device takeover, on which the client wipes its local E2E identity keys (see auth.md).",
            "headers": {
              "Set-Cookie": {
                "description": "Clears the HttpOnly refresh token cookie",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./models.json#/components/schemas/RefreshError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout the current user",
        "description": "Invalidates the refresh token by sessionId and clears the HttpOnly cookie.",
        "operationId": "logout",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully logged out",
            "headers": {
              "Set-Cookie": {
                "description": "Clears the HttpOnly refresh token cookie",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/auth/user": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get Current User Profile",
        "operationId": "getCurrentUser",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user profile information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./models.json#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid access token"
          },
		  "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/messages": {
      "post": {
        "tags": ["Messages"],
        "summary": "Send an encrypted message",
        "description": "Submits an E2E-encrypted, sender-signed message. The Server is the sole entry point for sending (clients never send through a Hub). It takes durable ownership and publishes the payload to RabbitMQ for live delivery. 'senderId' is set from the authenticated session; any client-provided value is ignored.",
        "operationId": "sendMessage",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/EncryptedMessage" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted: the Server has durably taken ownership of the message",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/AcceptedResponse" }
              }
            }
          },
          "400": { "description": "Malformed message or missing signature" },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/messages/batch": {
      "post": {
        "tags": ["Messages"],
        "summary": "Submit a batch of messages (resync)",
        "description": "Re-submits multiple unconfirmed outbox messages in a single call — e.g. after the client detects a Server restart (changed 'serverStartedAt'). Returns a per-message result and the current 'serverStartedAt'.",
        "operationId": "sendMessages",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/MessageBatchRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted: the Server has durably taken ownership of each message",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/MessageBatchResponse" }
              }
            }
          },
          "400": { "description": "Empty or oversized batch, or a malformed message" },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/inbox": {
      "get": {
        "tags": ["Messages"],
        "summary": "Sync undelivered messages",
        "description": "Returns the recipient's undelivered messages from the Server-owned inbox (hot tier + durable store), in arrival order.",
        "operationId": "getInbox",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The recipient's pending messages",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/InboxResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/receipts": {
      "post": {
        "tags": ["Messages"],
        "summary": "Submit a signed delivery/read receipt",
        "description": "The recipient acknowledges a message with a receipt signed by its identity key.",
        "operationId": "submitReceipt",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/DeliveryReceipt" }
            }
          }
        },
        "responses": {
          "204": { "description": "Receipt accepted" },
          "400": { "description": "Invalid or unverifiable signature" },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/hubs/register": {
      "post": {
        "tags": ["Hubs"],
        "summary": "Register a Hub and provision its relay queue",
        "description": "Called by a Hub on boot. The Hub authenticates with a registration bearer token",
        "operationId": "registerHub",
        "security": [{ "HubRegistrationAuth": [] }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/HubRegistrationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hub registered; relay queue provisioned",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/HubRegistrationResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid registration token" }
        }
      }
    }
    ,
    "/keys": {
      "put": {
        "tags": ["Keys"],
        "summary": "Upload or replace caller's public keys",
        "description": "Authenticated user uploads their current public signing and encryption keys. The server records them in the public key directory. The userId is taken from the authenticated session and any client-provided userId is ignored.",
        "operationId": "uploadKeys",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/KeysUploadRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Public keys stored or replaced",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/KeysResponse" }
              }
            }
          },
          "400": { "description": "Malformed request" },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      },
      "get": {
        "tags": ["Keys"],
        "summary": "Batch fetch public keys",
        "description": "Fetch public keys for multiple users via a comma-separated `ids` query parameter.",
        "operationId": "getKeysBatch",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "description": "Comma-separated list of user ids to fetch public keys for",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Public keys for requested users",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/PublicKeysBatchResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/keys/{userId}": {
      "get": {
        "tags": ["Keys"],
        "summary": "Fetch a user's public keys",
        "description": "Retrieve the current public signing and encryption keys for a single user.",
        "operationId": "getKeysByUserId",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "ID of the user whose public keys are requested",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "The user's public keys",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/KeysResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid access token" },
          "404": { "description": "User not found or no keys published" }
        }
      }
    },
    "/groups": {
      "post": {
        "tags": ["Groups"],
        "summary": "Create a group",
        "description": "Creates a group with the caller as owner.",
        "operationId": "createGroup",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/CreateGroupRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Group created",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/Group" }
              }
            }
          },
          "400": { "description": "Malformed request or key set does not cover the roster" },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      },
      "get": {
        "tags": ["Groups"],
        "summary": "List the caller's groups",
        "description": "Lists the groups the caller is a member of.",
        "operationId": "listGroups",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The caller's groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "./models.json#/components/schemas/GroupSummary" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/groups/{groupId}": {
      "get": {
        "tags": ["Groups"],
        "summary": "Fetch a group's roster and epoch",
        "description": "Returns a group's roster and current epoch.",
        "operationId": "getGroup",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "The group descriptor",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/Group" }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid access token" },
          "403": { "description": "Caller is not a member of the group" },
          "404": { "description": "Group not found" }
        }
      }
    },
    "/groups/{groupId}/members": {
      "patch": {
        "tags": ["Groups"],
        "summary": "Add/remove members (owner only)",
        "description": "Adds or removes members and rotates the group key in the same call.",
        "operationId": "updateGroupMembers",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/UpdateMembersRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Roster updated and epoch advanced",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/Group" }
              }
            }
          },
          "400": { "description": "Key set does not cover the resulting roster" },
          "401": { "description": "Unauthorized - Missing or invalid access token" },
          "403": { "description": "Caller is not the group owner" },
          "404": { "description": "Group not found" },
          "409": { "description": "Epoch conflict: a concurrent rotation advanced the epoch; refetch and retry" }
        }
      }
    },
    "/groups/{groupId}/members/me": {
      "delete": {
        "tags": ["Groups"],
        "summary": "Leave a group",
        "description": "Removes the caller from the group.",
        "operationId": "leaveGroup",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "204": { "description": "Left the group" },
          "401": { "description": "Unauthorized - Missing or invalid access token" },
          "404": { "description": "Group not found or caller not a member" }
        }
      }
    },
    "/groups/{groupId}/keys": {
      "post": {
        "tags": ["Groups"],
        "summary": "Publish a rotated group key (any member)",
        "description": "Publishes a new epoch's group key for the current roster.",
        "operationId": "rotateGroupKey",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/GroupKeyDistribution" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rotation accepted; new epoch is current",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/Group" }
              }
            }
          },
          "400": { "description": "Key set does not cover the roster" },
          "401": { "description": "Unauthorized - Missing or invalid access token" },
          "403": { "description": "Caller is not a member of the group" },
          "404": { "description": "Group not found" },
          "409": { "description": "Epoch conflict: a concurrent rotation advanced the epoch; refetch and retry" }
        }
      },
      "get": {
        "tags": ["Groups"],
        "summary": "Fetch the caller's wrapped group key for an epoch",
        "description": "Returns the caller's wrapped group key for an epoch (recovery path).",
        "operationId": "getGroupKey",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "epoch",
            "in": "query",
            "required": false,
            "description": "The epoch to fetch; defaults to the current epoch.",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "The caller's wrapped key for the epoch",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/GroupKeySet" }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid access token" },
          "403": { "description": "Caller is not a member of the group" },
          "404": { "description": "Group, epoch, or wrapped key for the caller not found" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "CookieRefreshAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      },
      "HubRegistrationAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Hub registration token."
      }
    }
  }
}