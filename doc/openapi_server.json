{
  "openapi": "3.0.3",
  "info": {
    "title": "Fourletters API - Authentication",
    "version": "1.0.0",
    "description": "Authentication endpoints for the fourletters server"
  },
  "servers": [
    {
      "url": "http://localhost:8080/server/api/v1",
      "description": "Local Hub Development Server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentication and Identity Management"
    },
    {
      "name": "Messages",
      "description": "Sending messages, inbox sync, and signed delivery receipts"
    },
    {
      "name": "Hubs",
      "description": "Hub registration and relay-queue provisioning"
    },
    {
      "name": "Keys",
      "description": "User public-key directory: upload and fetch E2E keys"
    },
    {
      "name": "Groups",
      "description": "Group conversations: roster management"
    },
    {
      "name": "Users",
      "description": "User profile directory: display name and avatar lookups"
    }
  ],
  "paths": {
    "/auth/vk": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login using VK OAuth token",
        "description": "Validates the VK OAuth token and issues a new session. Single-active-device policy: a successful login revokes the user's other refresh tokens, so any previously signed-in device becomes revoked on its next refresh.",
        "operationId": "loginVk",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./models.json#/components/schemas/AuthRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully authenticated",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly cookie containing the 'refresh_token'.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./models.json#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token, User not found"
          }
        }
      }
    },
    "/auth/google": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login using Google OAuth token",
        "description": "Validates the Google OAuth token and issues a new session. Single-active-device policy: a successful login revokes the user's other refresh tokens, so any previously signed-in device becomes revoked on its next refresh.",
        "operationId": "loginGoogle",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./models.json#/components/schemas/AuthRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully authenticated",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly cookie containing the 'refresh_token'.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./models.json#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token, User not found"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh Access Token",
        "description": "Consumes the HttpOnly Refresh Token cookie to issue a new Access Token without requiring re-authentication.",
        "operationId": "refreshToken",
        "security": [
          {
            "CookieRefreshAuth": []
          }
        ],
        "parameters": [
          {
            "name": "X-Session-ID",
            "in": "header",
            "required": true,
            "description": "The current session ID. **Note:** This value must match the `jti` (JWT ID) claim of your current access token.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "New access token granted",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly cookie containing the 'refresh_token'.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./models.json#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token is invalid, expired, missing, or was revoked by a newer login. A 'revoked' reason signals the single-active-device takeover, on which the client wipes its local E2E identity keys (see auth.md).",
            "headers": {
              "Set-Cookie": {
                "description": "Clears the HttpOnly refresh token cookie",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./models.json#/components/schemas/RefreshError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout the current user",
        "description": "Invalidates the refresh token by sessionId and clears the HttpOnly cookie.",
        "operationId": "logout",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully logged out",
            "headers": {
              "Set-Cookie": {
                "description": "Clears the HttpOnly refresh token cookie",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/auth/user": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get Current User Profile",
        "operationId": "getCurrentUser",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user profile information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./models.json#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid access token"
          },
		  "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/messages": {
      "post": {
        "tags": ["Messages"],
        "summary": "Send an encrypted message",
        "description": "Submits an E2E-encrypted, sender-signed message. 'senderId' is set from the authenticated session; any client-provided value is ignored. A message targets exactly one destination: a 1:1 message carries 'recipientId' (no 'groupId'); a group message carries 'groupId' (no 'recipientId').",
        "operationId": "sendMessage",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/EncryptedMessage" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted: the Server has durably taken ownership of the message",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/AcceptedResponse" }
              }
            }
          },
          "400": { "description": "Malformed message or missing signature" },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/messages/batch": {
      "post": {
        "tags": ["Messages"],
        "summary": "Submit a batch of messages (resync)",
        "description": "Re-submits multiple unconfirmed outbox messages in a single call — e.g. after the client detects a Server restart (changed 'serverStartedAt'). Returns a per-message result and the current 'serverStartedAt'.",
        "operationId": "sendMessages",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/MessageBatchRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted: the Server has durably taken ownership of each message",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/MessageBatchResponse" }
              }
            }
          },
          "400": { "description": "Empty or oversized batch, or a malformed message" },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/inbox": {
      "get": {
        "tags": ["Messages"],
        "summary": "Sync undelivered messages",
        "description": "Returns the recipient's undelivered messages from the Server-owned inbox (hot tier + durable store), in arrival order.",
        "operationId": "getInbox",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The recipient's pending messages",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/InboxResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/receipts": {
      "post": {
        "tags": ["Messages"],
        "summary": "Submit a signed delivery/read/undecryptable receipt",
        "description": "The recipient acknowledges a message with a receipt signed by its identity key. A 'delivered'/'read' receipt is a positive ack; an 'undecryptable' receipt is a negative ack (the message was encrypted to a stale key) — the Server drops the retained copy just as for a delivery and relays it to the sender, who re-fetches the recipient's current key and resends once.",
        "operationId": "submitReceipt",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/DeliveryReceipt" }
            }
          }
        },
        "responses": {
          "204": { "description": "Receipt accepted" },
          "400": { "description": "Invalid or unverifiable signature" },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/receipts/batch": {
      "post": {
        "tags": ["Messages"],
        "summary": "Submit several signed receipts in one call",
        "description": "Records a batch of signed receipts in a single request",
        "operationId": "submitReceipts",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/ReceiptBatchRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "Receipts accepted" },
          "400": { "description": "Empty or oversized batch, or a malformed receipt" },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/hubs/register": {
      "post": {
        "tags": ["Hubs"],
        "summary": "Register a Hub and provision its relay queue",
        "description": "Called by a Hub on boot. The Hub authenticates with a registration bearer token",
        "operationId": "registerHub",
        "security": [{ "HubRegistrationAuth": [] }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/HubRegistrationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hub registered; relay queue provisioned",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/HubRegistrationResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid registration token" }
        }
      }
    }
    ,
    "/keys": {
      "put": {
        "tags": ["Keys"],
        "summary": "Upload or replace caller's Signal pre-key bundle",
        "description": "Authenticated user uploads their Signal pre-key bundle (identity key, registration id, signed pre-key and a pool of one-time pre-keys), replacing any previous bundle. The userId is taken from the authenticated session.",
        "operationId": "uploadKeys",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/KeysUploadRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Public keys stored or replaced",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/KeysResponse" }
              }
            }
          },
          "400": { "description": "Malformed request" },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      },
      "get": {
        "tags": ["Keys"],
        "summary": "Batch fetch public keys",
        "description": "Fetch public keys for multiple users via a comma-separated `ids` query parameter.",
        "operationId": "getKeysBatch",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "description": "Comma-separated list of user ids to fetch public keys for",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Public keys for requested users",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/PublicKeysBatchResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/keys/prekeys": {
      "post": {
        "tags": ["Keys"],
        "summary": "Replenish one-time pre-keys",
        "description": "Appends more one-time pre-keys to the caller's pool when it runs low.",
        "operationId": "replenishPreKeys",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/PreKeysUploadRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Pool replenished" },
          "400": { "description": "Malformed request" },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/keys/prekeys/count": {
      "get": {
        "tags": ["Keys"],
        "summary": "Count caller's remaining one-time pre-keys",
        "description": "Returns how many one-time pre-keys the caller still has in the directory (so the client can top up below a threshold) and the caller's currently published identity key (so a re-used device can detect a stale directory entry and re-publish).",
        "operationId": "countPreKeys",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Remaining one-time pre-key count",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/PreKeyCountResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/keys/{userId}": {
      "get": {
        "tags": ["Keys"],
        "summary": "Fetch a user's Signal pre-key bundle",
        "description": "Retrieve a user's pre-key bundle (identity, registration id, signed pre-key and at most one one-time pre-key, which is consumed by this call).",
        "operationId": "getKeysByUserId",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "ID of the user whose public keys are requested",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "The user's public keys",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/KeysResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid access token" },
          "404": { "description": "User not found or no keys published" }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Batch fetch user profiles",
        "description": "Fetch public profiles (display name and avatar) for multiple users via a comma-separated `ids` query parameter. Unknown ids are omitted from the result.",
        "operationId": "getUsersBatch",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "description": "Comma-separated list of user ids to fetch profiles for",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Public profiles for the requested users",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/UserBatchResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/users/{userId}": {
      "get": {
        "tags": ["Users"],
        "summary": "Fetch a user's public profile",
        "description": "Retrieve a single user's public profile (display name and avatar).",
        "operationId": "getUser",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "ID of the user whose profile is requested",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "The user's public profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/PublicUser" }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid access token" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/groups": {
      "post": {
        "tags": ["Groups"],
        "summary": "Create a group",
        "description": "Creates a group with the caller as owner.",
        "operationId": "createGroup",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/CreateGroupRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Group created",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/Group" }
              }
            }
          },
          "400": { "description": "Malformed request" },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      },
      "get": {
        "tags": ["Groups"],
        "summary": "List the caller's groups",
        "description": "Lists the groups the caller is a member of.",
        "operationId": "listGroups",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The caller's groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "./models.json#/components/schemas/GroupSummary" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid access token" }
        }
      }
    },
    "/groups/{groupId}": {
      "get": {
        "tags": ["Groups"],
        "summary": "Fetch a group's roster",
        "description": "Returns a group's roster.",
        "operationId": "getGroup",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "The group descriptor",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/Group" }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid access token" },
          "403": { "description": "Caller is not a member of the group" },
          "404": { "description": "Group not found" }
        }
      },
      "patch": {
        "tags": ["Groups"],
        "summary": "Update group metadata (owner only)",
        "description": "Partially updates a group's metadata (name and/or avatar). Only the provided fields are changed. The avatar is a base64 data URL stored plaintext server-side.",
        "operationId": "updateGroup",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/UpdateGroupRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Group updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/Group" }
              }
            }
          },
          "400": { "description": "Malformed request or avatar too large" },
          "401": { "description": "Unauthorized - Missing or invalid access token" },
          "403": { "description": "Caller is not the group owner" },
          "404": { "description": "Group not found" }
        }
      }
    },
    "/groups/{groupId}/members": {
      "patch": {
        "tags": ["Groups"],
        "summary": "Add/remove members (owner only)",
        "description": "Adds or removes members from the roster.",
        "operationId": "updateGroupMembers",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./models.json#/components/schemas/UpdateMembersRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Roster updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "./models.json#/components/schemas/Group" }
              }
            }
          },
          "401": { "description": "Unauthorized - Missing or invalid access token" },
          "403": { "description": "Caller is not the group owner" },
          "404": { "description": "Group not found" }
        }
      }
    },
    "/groups/{groupId}/members/me": {
      "delete": {
        "tags": ["Groups"],
        "summary": "Leave a group",
        "description": "Removes the caller from the group.",
        "operationId": "leaveGroup",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "204": { "description": "Left the group" },
          "401": { "description": "Unauthorized - Missing or invalid access token" },
          "404": { "description": "Group not found or caller not a member" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "CookieRefreshAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      },
      "HubRegistrationAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Hub registration token."
      }
    }
  }
}